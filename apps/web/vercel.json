{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/l/:code",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Embedly|vkShare|Line\/).*" }],
      "destination": "/api/leaderboard-share?code=:code"
    },
    { "source": "/l/:code", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/manage/:path*", "destination": "/index.html" },
    { "source": "/captain-invite", "destination": "/index.html" },
    { "source": "/competition-organizer-invite", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/competitions/:slug", "destination": "/index.html" },
    { "source": "/competitions/:slug/games/:matchId", "destination": "/index.html" },
    { "source": "/clans/:slug", "destination": "/index.html" },
    { "source": "/squads/:slug", "destination": "/index.html" },
    { "source": "/players/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/manage/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/captain-invite",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/competition-organizer-invite",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/forgot-password",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/reset-password",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
