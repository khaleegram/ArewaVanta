# Copy to .env.production, replace every marked placeholder, and protect it with chmod 600.
APP_NAME=ArewaVanta
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_A_GENERATED_32_BYTE_KEY
APP_URL=https://api.arewavanta.com
APP_TIMEZONE=Africa/Lagos
FRONTEND_URL=https://arewavanta.com
CORS_ALLOWED_ORIGINS=https://arewavanta.com
TRUSTED_PROXIES=*

# Database is private to the Compose network; never publish port 5432.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=arewavanta
DB_USERNAME=arewavanta
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DB_SSLMODE=prefer

LOG_CHANNEL=stderr
LOG_LEVEL=warning
PUBLIC_READ_RATE_LIMIT=120
PUBLIC_SEARCH_RATE_LIMIT=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=REPLACE_WITH_THE_RESEND_API_KEY
MAIL_FROM_ADDRESS=notifications@arewavanta.com
MAIL_FROM_NAME=ArewaVanta

# Optional: include valid values to enable browser push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@arewavanta.com

# The API host only. The public website remains hosted separately on Vercel.
API_DOMAIN=api.arewavanta.com

# Set matching PG* variables on the host/backup runner for secure backup access,
# or run the provided scripts inside the API container using its DB_* values.
